# Instance B bot config — copy to /srv/poker-b/bot.env and fill in.
#
# This file must be COMPLETE. It is loaded via BOT_ENV_FILE instead of the
# checkout's bot/.env, precisely so instance B never inherits instance A's
# settings — most importantly its DISCORD_TOKEN.

# --- A SECOND Discord application (not the existing bot re-invited) ---
# Two processes sharing one token both hold a gateway connection and both
# receive every event. Create a new app in the Developer Portal.
DISCORD_TOKEN=
DISCORD_APP_ID=

# The second group's channel, under which their session threads live.
DISCORD_CHANNEL_ID=

# Their roles (role IDs are per-server — instance A's IDs do not exist here).
# Leave blank to disable pings / streak roles.
DISCORD_POKER_ROLE_ID=
DISCORD_HOT_ROLE_ID=
DISCORD_COLD_ROLE_ID=

# Instance B's own tracker, NOT instance A's.
TRACKER_API_BASE=https://poker-b.example.com/api
TRACKER_UI_BASE=https://poker-b.example.com

# Must differ from instance A's 6300, and match BOT_BASE in the backend unit.
BOT_HTTP_PORT=6301

# Gemini (OCR of ledger screenshots). Can reuse the same key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PAYMENT_REMINDER_HOUR=10
PAYMENT_REMINDER_TZ=Pacific/Auckland

# Chips-to-dollars for PokerNow CSV imports (their stake, not yours).
POKERNOW_CHIP_DIVISOR=100
