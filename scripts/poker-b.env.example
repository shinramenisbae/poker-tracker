# Instance B bot config — copy to /srv/poker-b/bot.env and fill in.
#
# Only bootstrap values live here: the bot needs them to log in and find its
# tracker before it can read anything from the database. Everything Discord-side
# — the watched channel, the ping/streak roles, the reminder time, the chip
# divisor — is configured by the server owner with /setup, so nobody has to come
# back and edit this file.
#
# This file must be COMPLETE. It's loaded via BOT_ENV_FILE instead of the
# checkout's bot/.env, precisely so instance B never inherits instance A's
# settings — most importantly its DISCORD_TOKEN.

# --- A SECOND Discord application (not the existing bot re-invited) ---
# Two processes sharing one token both hold a gateway connection and both
# receive every event. Create a new app in the Developer Portal.
DISCORD_TOKEN=
DISCORD_APP_ID=

# Instance B's own tracker, NOT instance A's.
TRACKER_API_BASE=https://poker-b.example.com/api
TRACKER_UI_BASE=https://poker-b.example.com

# Must differ from instance A's 6300, and match BOT_BASE in the backend unit.
BOT_HTTP_PORT=6301

# Gemini (OCR of ledger screenshots). Can reuse the same key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Nothing below is needed ---
# The server owner sets these from Discord with /setup:
#   /setup channel:#poker poker_role:@Poker hot_role:@Hot cold_role:@Cold
#          reminder_hour:10 timezone:Pacific/Auckland chip_divisor:100
# They're still readable as env vars (DISCORD_CHANNEL_ID, DISCORD_POKER_ROLE_ID,
# DISCORD_HOT_ROLE_ID, DISCORD_COLD_ROLE_ID, PAYMENT_REMINDER_HOUR,
# PAYMENT_REMINDER_TZ, POKERNOW_CHIP_DIVISOR) as a fallback, but /setup wins and
# is the supported path.
