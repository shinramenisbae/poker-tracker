[Unit]
Description=Tribe Poker Bot — instance B (second group)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/.openclaw/workspace/poker-tracker/bot
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=5

# CRITICAL: instance B runs from the SAME checkout as instance A, so without
# BOT_ENV_FILE dotenv would load A's bot/.env and silently fill in anything B's
# config omits — including A's DISCORD_TOKEN, which would put two processes on
# one token (duplicate imports, double replies). Point it at B's own file.
Environment=BOT_ENV_FILE=/srv/poker-b/bot.env

[Install]
WantedBy=multi-user.target
