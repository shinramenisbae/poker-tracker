[Unit]
Description=Tribe Poker Tracker backend — second group
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/.openclaw/workspace/poker-tracker/backend
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

# This group's isolation. Each of these defaults to the FIRST group's value when
# unset, so every one must be set here.
Environment=PORT=5002
Environment=POKER_DB=/srv/poker-b/poker.db
Environment=CORS_ORIGINS=https://poker-b.example.com

# aliases-seed.json carries the FIRST group's roster — real names and the
# PokerNow nicknames they play under. Without this, a fresh database is seeded
# with it and this group's alias screen lists 45 strangers.
Environment=SEED_ALIASES=0

# Which Discord server this tracker belongs to. One bot process serves every
# server, so it can't tell which tracker a request is for unless the backend
# says — forwarded /announce, /repost etc. carry this id.
Environment=GUILD_ID=REPLACE_WITH_DISCORD_SERVER_ID

# The SHARED bot (there is only one process), so this stays the default 6300.
# Environment=BOT_BASE=http://127.0.0.1:6300

[Install]
WantedBy=multi-user.target
