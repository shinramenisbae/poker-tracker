# Copy to .env and fill in.

# Discord bot token (same one used by the backfill scripts).
DISCORD_TOKEN=

# ID of the Discord text channel under which session threads live.
DISCORD_CHANNEL_ID=

# Optional: role ID to @mention on each results post, so everyone in the role
# is pulled into the results thread. Right-click the role with Developer Mode
# on → Copy ID. The bot needs permission to mention this role. Leave blank to
# disable mentions.
DISCORD_POKER_ROLE_ID=

# Discord application (client) ID — required to register the /paid slash command.
# Developer Portal → your app → "Application ID". Without it, /paid is skipped.
DISCORD_APP_ID=

# Daily unpaid-debt reminder: hour (0-23) and IANA timezone. Default 10am NZ
# time (handles NZST/NZDT automatically). At this time the bot pings unpaid
# losers in each session thread that still has outstanding bank transfers.
PAYMENT_REMINDER_HOUR=10
PAYMENT_REMINDER_TZ=Pacific/Auckland

# Streak roles: create "Running Hot" and "Running Cold" roles in Discord and
# paste their IDs here. Won your last 3 played sessions → hot role; lost your
# last 3 → cold role; removed when the streak breaks. Players must be linked
# via /paid to receive roles. The bot's own role must sit ABOVE these two in
# the role list and have Manage Roles. Leave blank to disable role changes
# (streak lines still appear in results posts).
DISCORD_HOT_ROLE_ID=
DISCORD_COLD_ROLE_ID=

# --- Serving more than one Discord server (optional) ---
# Maps each server to its own tracker, so groups never share data. JSON array;
# operator-controlled on purpose — it must NOT be settable from Discord, or a
# server owner could point their guild at another group's tracker and read it.
# A server not listed here is ignored by the bot.
# Leave unset to use the single TRACKER_API_BASE below (original behaviour).
# GUILD_TRACKERS=[{"guildId":"111","apiBase":"https://poker.example.com/api","label":"Tribe A"},{"guildId":"222","apiBase":"https://poker-b.example.com/api","label":"Tribe B"}]
#
# REQUIRED once GUILD_TRACKERS lists more than one server: which server the
# DISCORD_CHANNEL_ID / role IDs above actually describe. Every other guild then
# inherits nothing from this file and must be configured with /setup in Discord.
# Without it, a server that hasn't run /setup would watch the channel named
# above — another group's — and scan it into its own tracker.
# DISCORD_GUILD_ID=111

# Base URL of the poker tracker API.
TRACKER_API_BASE=https://srv1346724.hstgr.cloud/api

# Where the tracker can reach this bot's announcement endpoint.
# In production both run on the same VPS so localhost is fine.
# Avoid ports on Node's undici "bad ports" list (6000 = X11, 6665-6669 = IRC, etc.)
BOT_HTTP_PORT=6300

# Public base URL of the tracker UI (used in "please map aliases" messages).
TRACKER_UI_BASE=https://srv1346724.hstgr.cloud

# Gemini API key (vision OCR of ledger screenshots).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Chips-to-dollars conversion for PokerNow CSV imports. Default 100 means
# 100 chips = $1 (the most common home-game stake). Set to 1 if your game
# actually plays in dollar units.
POKERNOW_CHIP_DIVISOR=100
